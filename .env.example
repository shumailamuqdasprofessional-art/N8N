# Server
PORT=3000
PUBLIC_URL=https://your-app.onrender.com

# Meta WhatsApp Cloud API
VERIFY_TOKEN=choose-any-secret-word
N8N_WEBHOOK_URL=https://YOUR-N8N/webhook/meta-whatsapp

# Twilio
TWILIO_AUTH_TOKEN=your-twilio-auth-token
N8N_TWILIO_SMS_URL=https://YOUR-N8N/webhook/twilio-sms
N8N_TWILIO_VOICE_URL=https://YOUR-N8N/webhook/twilio-events
N8N_TWILIO_STATUS_URL=https://YOUR-N8N/webhook/twilio-events
FORWARD_CALLS_TO=+15551234567
CALL_GREETING=Thank you for calling. Please hold while we connect you.

# Browser dialer (open https://YOUR-APP/dialer)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your-api-key-secret
TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CALLER_ID=+15551234567
DIALER_PASSWORD=choose-a-strong-password
RING_BROWSER=true
