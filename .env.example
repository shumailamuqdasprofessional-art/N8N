# Copy this file to .env and fill in your values. Never commit .env.

PORT=3000

# Any string you choose; enter the same value in the Meta dashboard "Verify token" field.
VERIFY_TOKEN=change-me

# Meta App Dashboard > App settings > Basic > App secret. Enables signature verification.
APP_SECRET=

# Default n8n Production Webhook URL (receives every event).
N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/meta

# Optional: send each product to its own n8n workflow (falls back to N8N_WEBHOOK_URL).
N8N_WEBHOOK_URL_WHATSAPP=
N8N_WEBHOOK_URL_INSTAGRAM=
N8N_WEBHOOK_URL_MESSENGER=

# Forwarding behaviour
FORWARD_TIMEOUT_MS=10000
FORWARD_RETRIES=3

# Max requests per IP per minute
RATE_LIMIT_PER_MINUTE=600
