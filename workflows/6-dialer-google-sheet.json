      "id": "a1b2c3d4-006-4000-8000-000000000002",
      "name": "Read Sheet",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// ===== EDIT THESE TWO LINES =====\nconst AGENT_PHONE = '+10000000009'; // your phone: answered calls connect here ('' = just play the message)\nconst DEFAULT_MESSAGE = 'Hello, this is a call from our team.';\n// ================================\n\nconst toE164 = (value) => {\n  const text = String(value || '').trim();\n  const digits = text.replace(/\\D/g, '');\n  if (text.startsWith('+') && digits.length >= 8) return '+' + digits;\n  if (digits.length === 10) return '+1' + digits;\n  if (digits.length === 11 && digits.startsWith('1')) return '+' + digits;\n  return null;\n};\nconst escapeXml = (s) => String(s).replace(/[<>&'\"]/g, (c) => ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', \"'\": '&apos;', '\"': '&quot;' }[c]));\n\nconst calls = [];\nfor (const item of $input.all()) {\n  const row = item.json;\n  if (String(row.Status || '').trim()) continue; // already called\n  const phone = toE164(row.Phone);\n  if (!phone) continue;\n\n  const name = String(row.Name || '').trim();\n  const message = String(row.Message || '').trim() || DEFAULT_MESSAGE;\n  const greeting = name ? `Hello ${name}. ${message}` : message;\n  let twiml = `<Response><Say>${escapeXml(greeting)}</Say>`;\n  if (AGENT_PHONE) twiml += `<Dial>${AGENT_PHONE}</Dial>`;\n  twiml += '</Response>';\n  calls.push({ json: { name, phone, sheetPhone: row.Phone, twiml } });\n}\nreturn calls;\n"
      },
      "id": "a1b2c3d4-006-4000-8000-000000000003",
      "name": "Build Call List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
