# Required — from the Twilio Console home page
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Password you type to open the dialer
DIALER_PASSWORD=choose-a-long-password

# Optional
# Your public https address (recommended once deployed)
PUBLIC_URL=https://your-dialer.example.com
# Which Twilio number to call from (default: your first Twilio number)
TWILIO_CALLER_ID=+12125550100
PORT=3000
