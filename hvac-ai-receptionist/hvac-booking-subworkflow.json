              "lookupColumn": "Date",
              "lookupValue": "={{ $json.date || 'none' }}"
            }
          ]
        }
      },
      "id": "84cfa949-f1af-42e0-8499-656f63d8bc01",
      "name": "Get Bookings That Day",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        60,
        200
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "",
          "name": "Google Sheets account"
        }
      },
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const b = $('Booking Settings & Validate').first().json;\nconst rows = $input.all().map((x) => x.json).filter((r) => r && r.Date);\nconst booked = (w) => rows.filter((r) =>\n  String(r.Date) === b.date && String(r.TimeWindow) === w &&\n  String(r.Status || '').toLowerCase() !== 'cancelled').length;\n\nconst freeWindows = b.slots.filter((w) => booked(w) < b.config.maxJobsPerWindow);\nconst available = !b.problem && freeWindows.includes(b.timeWindow);\n\nlet message = '';\nif (b.problem) message = 'NOT BOOKED. ' + b.problem;\nelse if (!available) message = freeWindows.length\n  ? `NOT BOOKED. The ${b.timeWindow} window on ${b.dateSpoken} is full. Free windows that day: ${freeWindows.join(', ')}.`\n  : `NOT BOOKED. ${b.dateSpoken} is fully booked. Ask the caller for another day.`;\n\nreturn [{ json: { ...b, available, freeWindows, message } }];"
      },
      "id": "9d9f7cd5-cabf-4d10-b092-a6ed6d5ae817",
      "name": "Check Availability",
      "type": "n8n-nodes-base.code",
