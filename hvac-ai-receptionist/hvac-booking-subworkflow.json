    },
    {
      "parameters": {
        "jsCode": "// ================= EDIT THESE SETTINGS =================\nconst config = {\n  businessName: 'Your HVAC Company',\n  timezone: 'America/New_York',\n  sheetId: 'YOUR_GOOGLE_SHEET_ID',      // same file as the call CRM\n  staffSmsNumber: '+15555550100',\n  maxJobsPerWindow: 2,                  // how many technicians per time window\n  closedWeekdays: [7],                  // 1 = Monday ... 7 = Sunday\n};\nconst slots = ['8am-10am', '10am-12pm', '12pm-2pm', '2pm-4pm', '4pm-6pm'];\n// =======================================================\n\nconst i = $input.first().json;\nconst norm = (s) => String(s || '').toLowerCase().replace(/\\s+|:00|\\./g, '').replace(/\u2013|\u2014|to/g, '-');\nconst timeWindow = slots.find((s) => norm(s) === norm(i.time_window)) || String(i.time_window || '');\n\nconst date = DateTime.fromISO(String(i.preferred_date || '').trim(), { zone: config.timezone });\nconst today = $now.setZone(config.timezone).startOf('day');\nlet problem = '';\nif (!date.isValid) problem = 'The date was not understood. Ask the caller for the date again.';\nelse if (date < today) problem = 'That date is in the past. Ask for a future date.';\nelse if (config.closedWeekdays.includes(date.weekday)) problem = `We are closed on ${date.toFormat('cccc')}s. Ask for another day.`;\nelse if (!slots.includes(timeWindow)) problem = `Time window must be one of: ${slots.join(', ')}.`;\n\nreturn [{\n  json: {\n    config, slots, problem,\n    customerName: String(i.customer_name || '').trim(),\n    phone: i.caller_phone || '',\n    twilioNumber: i.twilio_number || '',\n    callSid: i.call_sid || '',\n    address: String(i.service_address || '').trim(),\n    issue: String(i.issue || '').trim(),\n    date: date.isValid ? date.toISODate() : '',\n    dateSpoken: date.isValid ? date.toFormat('cccc, LLLL d') : '',\n    timeWindow,\n    bookingId: 'HV-' + $now.toFormat('yyMMdd') + '-' + Math.random().toString(36).slice(2, 6).toUpperCase(),\n    createdAt: $now.setZone(config.timezone).toFormat('yyyy-LL-dd HH:mm:ss'),\n  },\n}];"
      },
      "id": "d94e17e2-5c97-4148-9876-e6157b298b51",
      "name": "Booking Settings & Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        200
      ]
    },
