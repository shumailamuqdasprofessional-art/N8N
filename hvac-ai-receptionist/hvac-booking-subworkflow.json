      "parameters": {
        "content": "## HVAC Booking (sub-workflow)\nCalled by the AI receptionist's **Book_Appointment** tool.\nEdit settings in **Booking Settings & Validate**. Bookings go to the **Bookings** sheet tab.\nCopy this workflow's ID into the main workflow.",
        "height": 220,
        "width": 420,
        "color": 4
      },
      "id": "d057ee54-121b-4491-846a-01ab1ffbc77c",
      "name": "Note fd9199",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -160
      ]
    },
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "customer_name"
            },
            {
              "name": "service_address"
            },
            {
