      "id": "768b0d42-60fa-4ce7-8e38-12fbc0410cb5",
      "name": "When Called by AI Receptionist",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        -380,
        200
